# Copy this file to ".env" and fill in your own values. The .env file is gitignored and must
# stay that way: the mail account's password is a secret and belongs nowhere near the repository.
#
#   cp .env.example .env
#
# A real environment variable always beats this file, so a production machine configured by
# deploy/start-service.cmd is unaffected by whatever is here.

# ---------------------------------------------------------------- docker compose
# Only read by docker-compose.yml, on a server that runs it (DEPLOY.md section 4c).

# The address staff will type, without https://. Its DNS must point at the server.
DOMAIN=finance.example.com
# Let's Encrypt writes here if the certificate ever has trouble renewing.
ACME_EMAIL=it@example.com

# Optional: a setup code of your own choosing. Left empty, one is generated and printed in
# `docker compose logs blackstone` on first start.
FR_SETUP_TOKEN=

# ---------------------------------------------------------------- outgoing email
# Used only to send password reset links. Without it the system does not pretend to have sent
# anything: it shows the administrator the one-time link to hand over instead.

# The address resets appear to come from. Usually the same as FR_SMTP_USER.
FR_MAIL_FROM=finance@yourcompany.com

# Your mail provider's outgoing server.
#   Google Workspace / Gmail   smtp.gmail.com        port 587
#   Microsoft 365              smtp.office365.com    port 587
FR_SMTP_HOST=smtp.gmail.com
FR_SMTP_PORT=587

# The mailbox to send through, and its password.
#
# Use an APP PASSWORD, not the account's own sign-in password. An app password can be revoked
# on its own without changing anything else, and it is the only thing that works if the account
# has two-factor authentication - which it should.
#   Google:    myaccount.google.com/apppasswords
#   Microsoft: security.microsoft.com  (App passwords)
FR_SMTP_USER=finance@yourcompany.com
FR_SMTP_PASS=your-app-password-here

# Port 465 is TLS from the first byte; 587 upgrades with STARTTLS. Leave this out unless your
# provider needs it overridden.
# FR_SMTP_SECURE=0

# Some providers take a single URL instead of the separate settings above. If set, it wins.
# FR_SMTP_URL=smtps://user:pass@smtp.example.com:465

# ---------------------------------------------------------------- addresses
# The address people actually open, which is what a reset link in an email points at. On this
# machine it is the local one; in the office it is the name Caddy answers to. Under
# docker compose it is set from DOMAIN and this line is not used.
# FR_ORIGIN=http://localhost:3403
