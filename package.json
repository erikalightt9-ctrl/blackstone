{
  "name": "finance-requests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "coverage": "node --experimental-test-coverage --test-coverage-include=src/*.mjs --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test tests/*.test.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "backup": "node scripts/backup.mjs",
    "go-live": "node scripts/go-live.mjs",
    "restore": "node scripts/restore.mjs",
    "clear-transactions": "node scripts/clear-transactions.mjs",
    "mail:check": "node scripts/mail-check.mjs"
  },
  "dependencies": {
    "nodemailer": "^10.0.10",
    "zod": "^4.4.3"
  }
}
