# The bundled HTTPS front door, used only with `docker compose --profile caddy`. DOMAIN comes
# from .env. A server that already runs its own Caddy uses deploy/Caddyfile.site instead.
#
# Caddy obtains a Let's Encrypt certificate for DOMAIN on first start and renews it by itself.
# That needs DOMAIN's DNS pointed at this server and ports 80 and 443 open to the internet.

{$DOMAIN} {
	encode zstd gzip

	reverse_proxy blackstone:3403 {
		# Caddy sets X-Forwarded-For to the real visitor itself. A CF-Connecting-IP header can
		# only have been typed by the visitor, since no Cloudflare is in front, so it is removed
		# rather than passed on for the app to believe.
		header_up -CF-Connecting-IP
	}
}
